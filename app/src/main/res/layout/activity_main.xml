<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full screen camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Front camera PiP -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewViewFront"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_margin="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="gone" />

    <!-- Tracking overlay -->
    <com.example.sportsballtracker.TrackingOverlayView
        android:id="@+id/trackingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status text (top left) -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="等待偵測球體…"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:background="#99000000"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="12dp" />

    <!-- Right side controls -->
    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#66000000"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="8dp">

        <!-- Mode -->
        <TextView
            android:id="@+id/modeVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="錄影"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/mode_selected_bg"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/modePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="相片"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="12dp" />

        <!-- Shutter -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="12dp">

            <View
                android:id="@+id/shutterRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shutter_ring" />

            <View
                android:id="@+id/shutterButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/shutter_circle"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>

        <!-- Switch camera -->
        <TextView
            android:id="@+id/btnSwitchCamera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_dark"
            android:gravity="center"
            android:text="🔄"
            android:textSize="20sp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp" />

        <!-- Dual camera -->
        <TextView
            android:id="@+id/btnDualCamera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_dark"
            android:gravity="center"
            android:text="雙"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp" />

        <!-- Editor -->
        <TextView
            android:id="@+id/btnEditor"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_dark"
            android:gravity="center"
            android:text="📁"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp" />

        <!-- Photo / Record shortcuts -->
        <TextView
            android:id="@+id/btnPhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="拍照"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnRecord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="錄影"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
