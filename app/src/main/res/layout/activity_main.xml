<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full screen camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Front camera PiP -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewViewFront"
        android:layout_width="110dp"
        android:layout_height="150dp"
        android:layout_margin="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone" />

    <!-- Tracking overlay -->
    <com.example.sportsballtracker.TrackingOverlayView
        android:id="@+id/trackingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status text -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="等待偵測球體…"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:background="#99000000"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="12dp" />

    <!-- Controls overlay -->
    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#66000000"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Mode selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/modePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="相片"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp" />

            <TextView
                android:id="@+id/modeVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="錄影"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:background="@drawable/mode_selected_bg" />
        </LinearLayout>

        <!-- Main controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp">

            <!-- Left: Editor button -->
            <TextView
                android:id="@+id/btnEditor"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/circle_dark"
                android:gravity="center"
                android:text="📁"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Center shutter -->
            <FrameLayout
                android:layout_width="76dp"
                android:layout_height="76dp">

                <View
                    android:id="@+id/shutterRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/shutter_ring" />

                <View
                    android:id="@+id/shutterButton"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:background="@drawable/shutter_circle"
                    android:clickable="true"
                    android:focusable="true" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Right: Switch camera -->
            <TextView
                android:id="@+id/btnSwitchCamera"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/circle_dark"
                android:gravity="center"
                android:text="🔄"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Secondary buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/btnDualCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="雙鏡頭"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="拍照"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnRecord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="錄影"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
